# ==================== 应用服务 ====================
# 单机使用保持 127.0.0.1。只有可信局域网部署时才改为 0.0.0.0。
APP_HOST=127.0.0.1
APP_PORT=8000

# ==================== llama.cpp ====================
LLAMA_CPP_URL=http://127.0.0.1:8080/v1/chat/completions
# 应与 llama-server 的 --alias 完全一致
MODEL_NAME=dental-qwen
LLM_TIMEOUT_SECONDS=240
LLM_MAX_TOKENS_EXTRACTION=2048
LLM_MAX_TOKENS_RECORD=4096
LLM_MAX_TOKENS_CHAT=1536
# 新版 llama.cpp 可用 JSON 约束；旧版不支持时程序会自动降级
LLM_JSON_MODE=true
# 对支持 thinking 的 Qwen 模型关闭长思考，减少延迟和格式漂移
LLM_DISABLE_THINKING=true

# ==================== Faster-Whisper ====================
# CPU 入门：base + cpu + int8
# GPU 推荐：small + cuda + float16
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_INITIAL_PROMPT=口腔科门诊医患对话，包含牙位、龋病、牙髓炎、根尖周炎、牙周炎、根管治疗、洁治、拔牙、种植、正畸等专业术语。
WHISPER_MODEL_DIR=models

# ==================== 数据与上传 ====================
DB_PATH=data/dental_records.db
EXPORT_DIR=exports
MAX_AUDIO_FILE_SIZE_MB=500
AUDIO_UPLOAD_CHUNK_MB=1

# ==================== 录音文字与文档导入 ====================
MAX_TEXT_FILE_SIZE_MB=20
MAX_IMPORTED_TEXT_CHARS=21600
TRANSCRIPT_CHUNK_CHARS=1800
MAX_TRANSCRIPT_CHUNKS=12

# ==================== 多模态病例图片 ====================
VISION_ENABLED=true
LLM_MAX_TOKENS_VISION=3072
MAX_IMAGE_FILE_SIZE_MB=16
MAX_IMAGES_PER_VISIT=24
MAX_IMAGES_PER_ANALYSIS=6
IMAGE_STORE_MAX_EDGE=1800
IMAGE_ANALYSIS_MAX_EDGE=768
IMAGE_THUMB_MAX_EDGE=320
